APP_NAME=Exposure-Check-OSINT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite by default (zero-config, stored in storage/app/database.sqlite).
# For MySQL see docs/SELF-HOSTING.md.
DB_CONNECTION=sqlite

# Single admin sign-in password (install.sh generates a random one; the
# container entrypoint also generates one on first boot if missing).
ADMIN_PASSWORD=

# Community license (free key: https://2mny.com/community-license)
LICENSE_SERVER_URL=https://2mny.com
LICENSE_TRIAL_DAYS=14

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
