{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "2mny/exposure-check-osint",
    "type": "project",
    "description": "Self-hosted personal exposure checker: email / username / phone / password / IP against 21 keyless OSINT sources. Non-AI, Laravel + Docker, k-anonymity password checks.",
    "keywords": [
        "osint",
        "email-osint",
        "data-breach",
        "leaked-data",
        "digital-footprint",
        "public-data",
        "breach-check",
        "haveibeenpwned",
        "stealer-logs",
        "username-check",
        "phone-lookup",
        "password-check",
        "k-anonymity",
        "self-hosted",
        "laravel",
        "docker",
        "privacy"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
    "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
