# Keep secrets + noise out of the image (COPY . . would bake them in)
.env
.env.backup
.env.production
.git
.gitignore
.github
.phpunit.cache
.idea
.vscode
vendor
node_modules
storage/app/database.sqlite
storage/app/license-install-id
storage/app/admin-password.txt
storage/app/env
storage/app/osint-logos
storage/app/osint-avatars
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
tests
docs
assets
pdfs
*.md
!README.md
!LICENSE
